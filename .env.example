# ============================================================
# Neon (PostgreSQL) 接続文字列
#  - Neon のダッシュボード > Connection Details からコピー
#  - Pooled connection (…-pooler.…) を DATABASE_URL に使用
#  - Direct connection を DIRECT_URL に使用（マイグレーション用）
# ============================================================
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# NextAuth (Auth.js v5)
#  - AUTH_SECRET は `npx auth secret` または `openssl rand -base64 32` で生成
# ============================================================
AUTH_SECRET="ここに32バイト以上のランダム文字列"

# 本番URL（Vercelでは自動設定されるため通常は不要）
# AUTH_URL="https://your-app.vercel.app"

# ============================================================
# 初期管理者アカウント（seed 実行時に作成される）
# ============================================================
SEED_ADMIN_EMAIL="admin@kampo-kagoshima.example.jp"
SEED_ADMIN_PASSWORD="Admin1234!"
